{
  "manifest_version": 3,
  "name": "Bambuddy — импорт из MakerWorld",
  "version": "1.1.0",
  "description": "Отправляйте профили печати из MakerWorld в Bambuddy одним нажатием.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs"
  ],
  "host_permissions": [
    "https://makerworld.com/*"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Отправить в Bambuddy"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://makerworld.com/*"
      ],
      "js": [
        "content.js",
        "page-ui.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
